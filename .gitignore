# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# velite (content build output)
.velite

# opennext (cloudflare build output)
.open-next

# remotion (video generation, not needed for web deploy)
/remotion

naver-indexing/*

# 네이버 플레이스 수집 결과·로그 (Supabase 로 적재해서 쓴다)
place_stats.jsonl
naver_reviews.log
dev.log